import Mathlib.Data.Fintype.Card
import Mathlib.Data.Finset.Card
import Mathlib.Logic.Function.Iterate
import Lean.Elab.Tactic.Omega

/-! The finite-involution principle, independent of the cube theorem. -/

namespace WingBijection

open Function

theorem involution_card_parity {X : Type*} [DecidableEq X]
    (f : X → X) (hf : Involutive f) (s : Finset X)
    (hs : ∀ x ∈ s, f x ∈ s) :
    s.card % 2 = (s.filter (fun x => f x = x)).card % 2 := by
  classical
  induction s using Finset.strongInductionOn with
  | _ s ih =>
    by_cases hex : ∃ x ∈ s, f x ≠ x
    · obtain ⟨x, hx, hne⟩ := hex
      have hfx : f x ∈ s := hs x hx
      have hxx : x ≠ f x := Ne.symm hne
      let t := (s.erase x).erase (f x)
      have ht : t ⊂ s := by
        refine Finset.ssubset_iff_subset_ne.mpr ⟨?_, ?_⟩
        · exact (Finset.erase_subset _ _).trans (Finset.erase_subset _ _)
        · intro he
          have : x ∈ t := he.symm ▸ hx
          simp [t] at this
      have htclosed : ∀ y ∈ t, f y ∈ t := by
        intro y hy
        simp only [t, Finset.mem_erase] at hy ⊢
        refine ⟨?_, ?_, hs y hy.2.2⟩
        · intro he
          exact hy.2.1 (hf.injective he)
        · intro he
          have hh := congrArg f he
          rw [hf y] at hh
          exact hy.1 hh
      have hcard : t.card + 2 = s.card := by
        have h1 := Finset.card_erase_add_one hx
        have h2 := Finset.card_erase_add_one
          (show f x ∈ s.erase x from Finset.mem_erase.mpr ⟨hne, hfx⟩)
        dsimp [t]
        omega
      have hfilter : t.filter (fun y => f y = y) =
          s.filter (fun y => f y = y) := by
        ext y
        simp only [t, Finset.mem_filter, Finset.mem_erase]
        constructor
        · rintro ⟨⟨_, _, hy⟩, hfix⟩
          exact ⟨hy, hfix⟩
        · rintro ⟨hy, hfix⟩
          refine ⟨⟨?_, ?_, hy⟩, hfix⟩
          · intro he
            subst y
            rw [hf x] at hfix
            exact hne hfix.symm
          · intro he
            subst y
            exact hne hfix
      have hh := ih t ht htclosed
      rw [hfilter] at hh
      omega
    · have hh : s.filter (fun x => f x = x) = s := by
        apply Finset.filter_eq_self.mpr
        intro x hx
        by_contra h
        exact hex ⟨x, hx, h⟩
      rw [hh]

theorem exists_fixed_of_unique_fixed {X : Type*} [Fintype X]
    (L R : X → X) (hL : Involutive L) (hR : Involutive R)
    (a : X) (ha : ∀ x, L x = x ↔ x = a) :
    ∃ x, R x = x := by
  classical
  have hleft := involution_card_parity L hL Finset.univ (by simp)
  have hright := involution_card_parity R hR Finset.univ (by simp)
  have hl : Finset.univ.filter (fun x => L x = x) = {a} := by
    ext x
    simp [ha]
  rw [hl] at hleft
  simp only [Finset.card_singleton, Nat.one_mod] at hleft
  by_contra hn
  have hr : Finset.univ.filter (fun x => R x = x) = ∅ := by
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.notMem_empty,
      iff_false]
    exact fun h => hn ⟨x, h⟩
  rw [hr] at hright
  simp only [Finset.card_empty, Nat.zero_mod] at hright
  omega

/-- The component generated by the two involutions from the anchor. -/
inductive Reach {X : Type*} (L R : X → X) (a : X) : X → Prop
  | base : Reach L R a a
  | left {x} : Reach L R a x → Reach L R a (L x)
  | right {x} : Reach L R a x → Reach L R a (R x)

theorem reachable_fixed {X : Type*} [Fintype X]
    (L R : X → X) (hL : Involutive L) (hR : Involutive R)
    (a : X) (ha : ∀ x, L x = x ↔ x = a) :
    ∃ x, Reach L R a x ∧ R x = x := by
  classical
  let C := {x : X // Reach L R a x}
  let l : C → C := fun x => ⟨L x.val, Reach.left x.property⟩
  let r : C → C := fun x => ⟨R x.val, Reach.right x.property⟩
  have hl : Involutive l := fun x => Subtype.ext (hL x.val)
  have hr : Involutive r := fun x => Subtype.ext (hR x.val)
  let root : C := ⟨a, Reach.base⟩
  have hroot : ∀ x : C, l x = x ↔ x = root := by
    intro x
    constructor
    · intro h
      exact Subtype.ext ((ha x.val).mp (congrArg Subtype.val h))
    · rintro rfl
      exact Subtype.ext ((ha a).mpr rfl)
  obtain ⟨x, hx⟩ := exists_fixed_of_unique_fixed l r hl hr root hroot
  exact ⟨x.val, x.property, congrArg Subtype.val hx⟩

theorem reach_normal_form {X : Type*} (L R : X → X)
    (hL : Involutive L) (hR : Involutive R) (a : X) (ha : L a = a)
    {x : X} (hx : Reach L R a x) :
    ∃ k : ℕ, x = (L ∘ R)^[k] a ∨ x = R ((L ∘ R)^[k] a) := by
  induction hx with
  | base => exact ⟨0, Or.inl rfl⟩
  | @left x hx ih =>
    obtain ⟨k, hk | hk⟩ := ih
    · cases k with
      | zero => exact ⟨0, Or.inl (by simpa only [iterate_zero_apply, hk] using ha)⟩
      | succ k =>
        refine ⟨k, Or.inr ?_⟩
        rw [hk, iterate_succ_apply', comp_apply, hL]
    · refine ⟨k + 1, Or.inl ?_⟩
      rw [hk, iterate_succ_apply', comp_apply]
  | @right x hx ih =>
    obtain ⟨k, hk | hk⟩ := ih
    · exact ⟨k, Or.inr (congrArg R hk)⟩
    · exact ⟨k, Or.inl ((congrArg R hk).trans (hR _))⟩

/-- The exact alternating iteration used by the algorithm eventually reaches an R-fixed state. -/
theorem alternating_terminates {X : Type*} [Fintype X]
    (L R : X → X) (hL : Involutive L) (hR : Involutive R)
    (a : X) (ha : ∀ x, L x = x ↔ x = a) :
    ∃ k : ℕ, R ((L ∘ R)^[k] a) = (L ∘ R)^[k] a := by
  obtain ⟨x, hx, hfix⟩ := reachable_fixed L R hL hR a ha
  obtain ⟨k, hk | hk⟩ := reach_normal_form L R hL hR a ((ha a).mpr rfl) hx
  · exact ⟨k, hk ▸ hfix⟩
  · refine ⟨k, ?_⟩
    rw [hk] at hfix
    exact hfix.symm.trans (hR _)

end WingBijection
